# Render.com Environment Variables
# Copy these to Render dashboard when deploying

# Groq API Keys
GROQ_API_KEY=your_groq_key_1
GROQ_API_KEY_2=your_groq_key_2
GROQ_API_KEY_3=your_groq_key_3

# Gemini
GEMINI_API_KEY=your_gemini_key

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_token

# Supabase
SUPABASE_URL=https://nnlwhgpjmjnzmxeslbks.supabase.co
SUPABASE_KEY=your_supabase_key
SUPABASE_ADMIN_KEY=your_supabase_admin_key

# Git Config
GIT_USER_NAME=owner
GIT_USER_EMAIL=owner@localhost

# For Render, we'll clone the Proximity app during build
